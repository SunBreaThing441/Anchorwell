# ==========================================
# PsychBuddy Environment Configuration Template
# Copy this file to .env and replace placeholder values
# ==========================================

# ------------------------------------------
# Django Core Settings
# ------------------------------------------
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*
PORT=8000

# ------------------------------------------
# MySQL Database Configuration
# ------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=psychbuddy
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# ------------------------------------------
# Email & OTP Notification Settings (Yagmail / SMTP)
# ------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# ------------------------------------------
# Third-Party APIs
# ------------------------------------------
# Get your free API key at https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# ------------------------------------------
# AI Assistant (GIA / Rasa) Settings
# ------------------------------------------
RASA_SERVER_URL=http://localhost:5005
GIA_PROJECT_DIR=G:/psychbuddy/GIA/

# ------------------------------------------
# Default Admin Credentials
# ------------------------------------------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
